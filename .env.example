# Copy to .env (gitignored) and fill in. Never commit real credentials.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps -> create app.
# Admin API scopes: read_products, write_products, read_files, write_files,
#                   read_themes, write_themes, read_publications, write_publications
SHOPIFY_STORE=your-store-handle
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, defaults to 2025-01
SHOPIFY_API_VERSION=2025-01
